#!/bin/sh

# Use Theos's rootless path resolution in shell scripts too
if [ -d "/private/preboot" ] && [ -n "$(find /private/preboot -name procursus -type d 2>/dev/null)" ]; then
    # Dopamine-style rootless
    PATH_PREFIX="$(find /private/preboot -name procursus -type d 2>/dev/null | head -1)"
    TYPE_PREFIX="Dopamine-style rootless"
    echo "Dopamine-style rootless environment detected"
elif [ -d "/var/jb" ]; then
    # Simple rootless (palera1n, etc)
    PATH_PREFIX="/var/jb"
    TYPE_PREFIX="simple rootless (palera1n, etc)"
    echo "Simple rootless (palera1n, etc) environment detected"
else
    # Rootful
    PATH_PREFIX=""
    TYPE_PREFIX="rootful"
    echo "Traditional rootful environment"
fi

# Use dynamic paths
ZXTOUCH_PATH="${PATH_PREFIX}/var/mobile/Library/ZXTouch"
echo "Using ZXTouch path: $ZXTOUCH_PATH"
BIN_PATH="${PATH_PREFIX}/usr/bin"
APPLICATIONS_PATH="${PATH_PREFIX}/Applications"
SUBSTRATE_PATH="${PATH_PREFIX}/Library/MobileSubstrate/DynamicLibraries"

echo "Using ZXTouch path: $ZXTOUCH_PATH"

# Handle ZXTouch directory
if [ -d "$ZXTOUCH_PATH" ]; then
    echo "Setting permissions for: $ZXTOUCH_PATH"
    chown -R mobile:mobile "$ZXTOUCH_PATH" 2>/dev/null || echo "⚠️ Could not change ownership (may be normal in rootless)"
    chmod -R 755 "$ZXTOUCH_PATH"
else
    echo "Creating directory: $ZXTOUCH_PATH"
    mkdir -p "$ZXTOUCH_PATH"
    chown -R mobile:mobile "$ZXTOUCH_PATH" 2>/dev/null || echo "⚠️ Could not change ownership (may be normal in rootless)"
    chmod -R 755 "$ZXTOUCH_PATH"
fi

# Make add_datetime.sh executable
if [ -f "${ZXTOUCH_PATH}/coreutils/ScriptRuntime/add_datetime.sh" ]; then
    chmod +x "${ZXTOUCH_PATH}/coreutils/ScriptRuntime/add_datetime.sh"
    echo "✅ Made add_datetime.sh executable"
else
    echo "⚠️ add_datetime.sh not found at ${ZXTOUCH_PATH}/coreutils/ScriptRuntime/add_datetime.sh"
fi

# Create legacy symlink for apps that reference /var/mobile/Library/ZXTouch
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    # Delete any existing file, directory, or link at the legacy path.
    # This prevents the "nesting" issue and ensures the link is created cleanly.
    if [ -e /var/mobile/Library/ZXTouch ] || [ -L /var/mobile/Library/ZXTouch ]; then
        rm -rf /var/mobile/Library/ZXTouch
    fi

    # Create the symbolic link at the Library level.
    # Legacy Path: /var/mobile/Library/ZXTouch
    # Rootless Path: /var/jb/var/mobile/Library/ZXTouch
    ln -s /var/jb/var/mobile/Library/ZXTouch /var/mobile/Library/ZXTouch
    echo "✅ Created legacy symlink /var/mobile/Library/ZXTouch -> /var/jb/var/mobile/Library/ZXTouch"

    # Run the permission fix script if it exists
    if [ -f "${ZXTOUCH_PATH}/fix-permissions.sh" ]; then
        sh "${ZXTOUCH_PATH}/fix-permissions.sh"
    fi
fi

# Update icon cache
if [ -f "${BIN_PATH}/uicache" ]; then
    "${BIN_PATH}/uicache"
fi

echo "Installation completed successfully for a ${TYPE_PREFIX} environment"